\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texmaths-pytools}[08/03/2026]

\RequirePackage{texmaths-path}

\makeatletter
\def\run@python#1{%
    \directlua{
        local python = "\luaescapestring{\texmaths@python@exe}"
        local project_root = "\luaescapestring{\texmaths@path@root}"
        if python == "" or project_root == "" then
            tex.error("texmaths-pytools: Python executable or project root not found")
        else
            local quote = string.char(34)
            local cd = "cd "
            if package.config:sub(1, 1) == string.char(92) then
                cd = "cd /d "
                project_root = project_root:gsub("/", string.char(92))
                python = python:gsub("/", string.char(92))
            end
            local cmd = cd .. quote .. project_root .. quote ..
                        " && " .. quote .. python .. quote ..
                        " " .. "\luaescapestring{#1}"

            print("")
            print("=== Start Python ===")
            print("Executing: " .. cmd)
            local ok, reason, code = os.execute(cmd)
            if ok ~= true and ok ~= 0 then
                tex.error("texmaths-pytools: Python command failed",
                          {tostring(reason) .. " " .. tostring(code)})
            end
            print("=== End Python ===")
        end
    }%
}
\makeatother